/* HUD trong trận (dùng chung màu sắc với Lobby.uss) */
.hud-root {
    align-items: flex-start;
    justify-content: flex-start;
}

.hud-card {
    width: 320px;
    padding: 12px;
}

.score-list {
    max-height: 180px;
}

.score-row {
    flex-direction: row;
    align-items: center;
    height: 26px;
    padding: 0 8px;
    margin: 1px 0;
    border-radius: 6px;
    background-color: rgba(36, 44, 66, 0.8);
}

.score-row.me {
    background-color: rgba(58, 110, 230, 0.55);
}

.score-rank {
    width: 24px;
    font-size: 13px;
    -unity-font-style: bold;
    color: rgb(255, 214, 120);
}

.score-name {
    flex-grow: 1;
    font-size: 13px;
    color: rgb(235, 240, 255);
}

.score-steps {
    font-size: 14px;
    -unity-font-style: bold;
    color: rgb(110, 214, 140);
    margin-right: 8px;
}

.score-best {
    font-size: 11px;
    color: rgb(150, 160, 185);
}
