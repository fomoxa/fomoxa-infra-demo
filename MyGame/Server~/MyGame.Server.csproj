<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <RollForward>Major</RollForward>
    <AssemblyName>MyGame.Server</AssemblyName>
    <RootNamespace>MyGame.Server</RootNamespace>
    <!-- Source vendor của 2 package dùng `string?` mà không bật #nullable:
         150 cảnh báo CS8632 không phải lỗi của code game. -->
    <NoWarn>$(NoWarn);CS8632</NoWarn>
    <Game>..</Game>
    <Deps>$(MSBuildThisFileDirectory)../../server-deps</Deps>
    <Core>$(Deps)/com.fomoxa.networking</Core>
    <Rpc>$(Deps)/com.fomoxa.rpc</Rpc>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="$(Core)/Runtime/Core/**/*.cs" />
    <Compile Include="$(Core)/Standalone~/**/*.cs" />
    <Compile Include="$(Rpc)/Runtime/Fomoxa.Rpc/**/*.cs" />
    <Compile Include="$(Rpc)/Runtime/Directory/**/*.cs" />
    <Compile Include="$(Game)/Assets/Network/Models/**/*.cs" />
    <Compile Include="$(Game)/Assets/Network/Generated/**/*.cs" />
    <Compile Include="$(Game)/Assets/Network/Rpc/Services.cs" />
    <Compile Include="$(Game)/../MyGame.Backend/MyGame.Backend/Accounts/Metrics.cs" />
    <Compile Include="*.cs" />
  </ItemGroup>

  <ItemGroup>
    <None Include="$(Game)/Assets/Network/Generated/*.fomoxascene" Link="Scenes/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="Fomoxa.Attributes">
      <HintPath>$(Core)/Runtime/Plugins/Fomoxa.Attributes.dll</HintPath>
    </Reference>
    <Reference Include="Fomoxa.Net">
      <HintPath>$(Core)/Runtime/Plugins/Fomoxa.Net.dll</HintPath>
    </Reference>
    <Reference Include="Fomoxa.Net.WebSockets">
      <HintPath>$(Core)/Runtime/Plugins/Fomoxa.Net.WebSockets.dll</HintPath>
    </Reference>
    <Analyzer Include="$(Rpc)/Runtime/Generators/Fomoxa.Rpc.Generator.dll" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="AgonesSDK" Version="1.61.0" />
    <PackageReference Include="BouncyCastle.Cryptography" Version="2.6.2" />
  </ItemGroup>

</Project>
