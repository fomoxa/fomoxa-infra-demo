# Multi-stage build cho fomoxa-directory (Rust)
FROM rust:1.88-bookworm AS build
WORKDIR /src

COPY gateway/ .

RUN cargo build --release -p fomoxa-directory

# Runtime image gọn nhẹ
FROM debian:bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY --from=build /src/target/release/fomoxa-directory /usr/local/bin/fomoxa-directory

EXPOSE 9500 9501

ENTRYPOINT ["fomoxa-directory"]
CMD ["directory.toml"]
