# Multi-stage build cho fomoxa-gateway (Rust)
FROM rust:1.88-bookworm AS build
WORKDIR /src

COPY gateway/ .

RUN cargo build --release -p fomoxa-gateway

# Runtime image gọn nhẹ
FROM debian:bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY --from=build /src/target/release/fomoxa-gateway /usr/local/bin/fomoxa-gateway

EXPOSE 7777/udp

ENTRYPOINT ["fomoxa-gateway"]
CMD ["gateway.toml"]
